# Copy this file to .env for local development.
# No secrets or external service configuration are required in the sample-data phase.
SEVAH_ENV=development
SEVAH_FACILITY_DATA_PATH=src/sevah/data/facilities.json

# Optional. When omitted, Sevah uses the bundled sample facilities.
# Enable Places API (New) for the Google Cloud project associated with this key.
GOOGLE_PLACES_API_KEY=
